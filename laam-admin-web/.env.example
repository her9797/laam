# 관리자 로그인 비밀번호. 운영 환경에서는 반드시 강력한 값으로 교체한다.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 로그인 세션 서명용 비밀키. 운영 환경에서는 충분히 긴 임의 문자열로 교체한다.
SESSION_SECRET=replace-with-a-long-random-value

# laam-api 관리자 API 호출에 사용하는 Bearer 토큰. laam-api의 ADMIN_API_TOKEN과 반드시 동일해야 한다.
ADMIN_API_TOKEN=replace-with-laam-api-admin-token

# laam-api 서버 주소. 로컬에서 `go run ./cmd/server`로 laam-api를 띄운 경우 기본값은 http://localhost:9090 이다.
# Docker Compose로 실행하는 경우 docker-compose.yml이 컨테이너 간 통신용 주소(http://laam-api:8080)를 별도로 주입하므로
# 이 값은 로컬 `npm run dev`/`npm run start` 실행에만 사용된다.
API_BASE_URL=http://localhost:9090

# 손님 요청 알림의 Realtime Broadcast 신호를 구독하기 위한 값이다(선택). 비워두면
# lib/supabase/client.ts의 getSupabaseClient()가 null을 반환해 구독을 건너뛰고
# 60초 안전망 폴링만으로 알림이 동작한다 — 자세한 내용은
# docs/plans/2026-09-04-admin-request-notifications.md 참고.
# NEXT_PUBLIC_ 접두사이므로 브라우저에 그대로 노출된다. anon/publishable key만 넣는다
# (secret/service_role 키를 여기 넣지 않는다).
NEXT_PUBLIC_SUPABASE_URL=https://escntlunkvcoiylczijh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVzY250bHVua3Zjb2l5bGN6aWpoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgyODEyODUsImV4cCI6MjEwMzg1NzI4NX0.MSZoTACZWK_6wGEPFPbYe3Umz0ECnsG6ztoKM_bEZ0E
