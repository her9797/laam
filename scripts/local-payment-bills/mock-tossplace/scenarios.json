    {
      "name": "e-refund",
      "title": "환불: 카드 결제로 완료된 계산서를 POS에서 취소",
      "posOrderId": "mock-pos-e",
      "webOrders": [
        { "id": "mock-e-1", "menuItemName": "롱아일랜드 아이스티", "categoryName": "칵테일", "tableNumber": "B-04", "amount": 13000, "createdAt": "now-35m" },
        { "id": "mock-e-2", "menuItemName": "감바스", "categoryName": "안주", "tableNumber": "B-04", "amount": 17000, "createdAt": "now-30m" }
      ],
      "posOrder": {
        "id": "mock-pos-e", "orderKey": "mock-e-1", "orderNumber": "M-E01", "source": "POS", "orderState": "COMPLETED",
        "openedAt": "now-35m", "completedAt": "now-6m",
        "chargePrice": { "totalAmount": 30000, "discountAmount": 0 },
        "lineItems": [
          { "item": { "title": "롱아일랜드 아이스티", "category": { "title": "칵테일" } }, "itemPrice": { "priceValue": 13000 }, "quantity": 1, "optionChoices": [] },
          { "item": { "title": "감바스", "category": { "title": "안주" } }, "itemPrice": { "priceValue": 17000 }, "quantity": 1, "optionChoices": [] }
        ]
      },
      "posPayments": [
        { "id": "mock-pay-e-card", "orderId": "mock-pos-e", "state": "APPROVED", "sourceType": "CARD", "paymentMethod": "신용카드", "amount": 30000, "taxAmount": 2727, "supplyAmount": 27273, "taxExemptAmount": 0, "approvedNo": "MOCKE001", "approvedAt": "now-6m", "createdAt": "now-6m", "cardDetails": { "cardBrand": "삼성" } }
      ],
      "steps": [
        { "webhook": "payment.approved", "paymentId": "mock-pay-e-card" },
        { "webhook": "order.completed" },
        { "mock": { "orders": { "mock-pos-e": { "orderState": "CANCELLED", "cancelledAt": "now" } }, "payments": { "mock-pay-e-card": { "state": "CANCELLED", "cancelledAt": "now" } } }, "note": "POS에서 결제 취소·환불" },
        { "webhook": "payment.cancelled", "paymentId": "mock-pay-e-card" },
        { "webhook": "order.cancelled" }
      ],
      "expect": {
        "billStatus": "CANCELLED", "totalAmount": 30000, "synced": true,
        "orders": { "CANCELLED": 2 }, "nativeRows": 0,
        "payments": { "mock-pay-e-card": "CANCELLED/CARD/30000" }
      }
