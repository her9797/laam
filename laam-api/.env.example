# Copy this file to .env.local and fill only the values needed locally.
APP_ADDR=:9090
DATABASE_URL='postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require'
ALLOWED_ORIGIN=http://localhost:3000
ADMIN_API_TOKEN=laam-admin-api-token

# Optional: Postgres statement_timeout applied to every pooled connection, in
# Go duration syntax (e.g. 15s, 500ms). Defaults to 15s when empty or invalid;
# 0 disables the limit. Keep it below the HTTP WriteTimeout (120s).
DB_STATEMENT_TIMEOUT=15s

# Optional: sends a best-effort Realtime Broadcast signal after a customer
# request is created (see internal/notify.Broadcaster). Leave both empty to
# disable sending entirely — the admin web's 60s safety-net poll still
# delivers the notification, just slower. SUPABASE_BROADCAST_KEY must be a
# server-only secret/service_role key, never the anon/publishable key.
SUPABASE_URL=
SUPABASE_BROADCAST_KEY=

# Optional: expense receipt photos in a private Supabase Storage bucket
# (reuses SUPABASE_URL above). SUPABASE_STORAGE_KEY must be a server-only
# secret/service_role key, never the anon/publishable key. While it is empty
# the receipt image endpoints return 503; receipts themselves keep working.
# The bucket is not created by the API: create it as a private bucket when
# deploying. EXPENSE_RECEIPT_BUCKET defaults to expense-receipts.
SUPABASE_STORAGE_KEY=
EXPENSE_RECEIPT_BUCKET=

# Required only for approving song requests into the store player queue.
# Create a server-side YouTube Data API v3 key; never expose it to either web app.
YOUTUBE_API_KEY=

# Admin table QR page only (GET /api/v1/admin/tables).
# QR_SIGNING_SECRET must be byte-for-byte identical to laam-web's
# QR_SIGNING_SECRET. If the two differ, laam-web cannot verify the signatures
# this API prints into the QR codes, so every issued QR is invalid and each
# scan lands on /access-required. It is a server-only secret: never expose it
# to any web app as NEXT_PUBLIC_*.
# CUSTOMER_WEB_BASE_URL is the customer web origin embedded in every QR URL,
# so it must be an address the customer's phone browser can reach directly —
# never a Compose-internal DNS name such as http://laam-web:8080.
# The endpoint returns 500 while either value is empty.
QR_SIGNING_SECRET=
CUSTOMER_WEB_BASE_URL=http://localhost:3000

# Required for catalog synchronization and POS order creation.
TOSS_PLACE_ACCESS_KEY=
TOSS_PLACE_SECRET_KEY=
TOSS_PLACE_MERCHANT_ID=

# Signing secret for the TossPlace order webhook
# (POST /api/v1/webhooks/tossplace/orders), issued when the webhook is
# registered in the TossPlace developer console — a different value from
# TOSS_PLACE_SECRET_KEY above, which authenticates our outgoing API calls.
# It is the only authentication on that endpoint: while it is empty every
# delivery is rejected with 401, so POS payments and cancellations silently
# stop syncing into payment_orders.status.
TOSS_PLACE_WEBHOOK_SECRET=
PAYMENT_API_TOKEN=laam-payment-api-token

# Keep open-api until the laam POS worker plugin is installed on the store POS.
# In plugin mode, use a separate long random server-only token and configure
# the same value in the plugin settings screen.
POS_ORDER_PROVIDER=open-api
POS_PLUGIN_API_TOKEN=
